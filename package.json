{
  "name": "webhaven",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "publisher": "node --env-file-if-exists=.env apps/publisher/src/main.js",
    "mirror": "node --env-file-if-exists=.env apps/mirror/src/main.js",
    "cli": "node --env-file-if-exists=.env apps/publisher/src/cli.js",
    "test": "node --test test/*.test.js",
    "check": "node bench/check.js",
    "bench": "node bench/run.js",
    "producer": "npm run publisher",
    "consumer": "npm run mirror"
  }
}
