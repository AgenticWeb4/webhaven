# Local-directory delivery (default). Use an absolute path on separate hosts/mounts.
DELIVERY_DRIVER=local
DELIVERY_DIR=var/delivery
PRODUCER_DATA_DIR=var/producer
CONSUMER_DATA_DIR=var/consumer
PRODUCER_HOST=127.0.0.1
PRODUCER_PORT=8081
CONSUMER_HOST=127.0.0.1
CONSUMER_PORT=8080
COLLECTIONS=docs
SYNC_INTERVAL_MS=30000
RETAIN_VERSIONS=3
MIN_FREE_BYTES=67108864
MAX_FILE_BYTES=20971520
MAX_VERSION_BYTES=262144000
# Replace this placeholder, or set PRODUCER_AUTH_FILE to a private JSON file.
PRODUCER_TOKENS='[{"token":"replace-with-a-random-token-at-least-24-characters","collections":["docs"],"permissions":["submit","publish"]}]'
WEBHAVEN_TOKEN=replace-with-a-random-token-at-least-24-characters
PRODUCER_URL=http://127.0.0.1:8081
ALLOW_PRIVATE_NETWORK=false
FETCH_TIMEOUT_MS=15000
# For S3 delivery: set DELIVERY_DRIVER=s3. Each process gets its own credentials.
# S3_ENDPOINT=https://your-s3-compatible-endpoint
# S3_BUCKET=webhaven-delivery
# S3_PREFIX=webhaven
# S3_REGION=us-east-1
# AWS_ACCESS_KEY_ID=producer-or-consumer-specific-key
# AWS_SECRET_ACCESS_KEY=producer-or-consumer-specific-secret
# Source S3 is configured independently, even with local-directory delivery.
# SOURCE_S3_ENDPOINT=https://your-source-endpoint
# SOURCE_S3_BUCKET=source-bucket
# SOURCE_S3_PREFIX=site/
# SOURCE_S3_REGION=us-east-1
# SOURCE_S3_ACCESS_KEY_ID=source-read-only-key
# SOURCE_S3_SECRET_ACCESS_KEY=source-read-only-secret
# Docker S3 override uses separate credentials for each process.
# PRODUCER_AWS_ACCESS_KEY_ID=delivery-writer-key
# PRODUCER_AWS_SECRET_ACCESS_KEY=delivery-writer-secret
# CONSUMER_AWS_ACCESS_KEY_ID=delivery-reader-key
# CONSUMER_AWS_SECRET_ACCESS_KEY=delivery-reader-secret
